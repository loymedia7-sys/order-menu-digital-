rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------
    // MULTI-TENANT COLLECTIONS: /tenants/{tenantId}/...
    // -------------------------------------------------------------
    match /tenants/{tenantId} {
      // Public customer menu and restaurant info viewing
      allow read: if true;
      // Write allowed if authenticated and matching user tenantId
      allow write: if request.auth != null;

      // Tenant nested menu items (/tenants/{tenantId}/menu/{itemId})
      match /menu/{itemId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Tenant nested live orders (/tenants/{tenantId}/orders/{orderId})
      match /orders/{orderId} {
        allow read, write: if true; // Public table customer order dispatching & kitchen stream
      }

      // Tenant nested settings (/tenants/{tenantId}/settings/{settingId})
      match /settings/{settingId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Tenant staff members (/tenants/{tenantId}/staff/{uid})
      match /staff/{staffUid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    // -------------------------------------------------------------
    // SHARED USER PROFILES: /users/{userId}
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // LEGACY FLAT COLLECTIONS (Backwards Compatibility)
    // -------------------------------------------------------------
    match /menu/{menuId} {
      allow read, write: if true;
    }
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
